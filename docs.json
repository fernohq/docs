        "pages": [
          "browser/setup",
          "browser/track",
          "browser/identify",
          "browser/alias",
          "browser/page",
          "browser/screen",
          "browser/group",
          "browser/identity",
          "browser/logout",
          "browser/instrumentation",
          "browser/utility-methods",
          "browser/delivery-strategy"
        ]
      },
      {
        "group": "Node SDK",
        "pages": [
          "node/setup",
          "node/track",
          "node/identify",
          "node/alias",
          "node/page",
          "node/screen",
          "node/group",
          "node/lifecycle"
