{
  "$schema": "./node_modules/@umami/shiso/docs.schema.json",
  "theme": "shiso",
  "name": "Ferno Docs",
  "description": "Ferno SDK documentation.",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/logo.svg",
  "colors": {
    "primary": "#cb4a28",
    "light": "#ff8b69",
    "dark": "#bd4322"
